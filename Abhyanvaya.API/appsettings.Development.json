{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "UseRedis": false,
  "EnrollmentBackground": {
    "Enabled": false
  },
  "EnrollmentRecovery": {
    "Enabled": false
  },
  "EnrollmentProgressBroadcast": {
    "Enabled": false
  },
  "ArtifactStorage": {
    "Provider": "local",
    "PhysicalRoot": "App_Data/artifacts"
  },
  "StudentPhotoProvider": {
    "ExamBranch": {
      "BaseUrlTemplate": "https://exambranch.com/PHOTOS/{collegeCode}/{academicYear}/{studentNumber}.jpg"
    }
  }
}
