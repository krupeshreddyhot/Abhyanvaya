  },
  "Dashboard": {
    "ReportingTimeZoneId": "Asia/Kolkata"
  },
  "Embedding": {
    "DefaultProvider": "InsightFace"
  },
  "StudentPhotoProvider": {
    "DefaultProvider": "ExamBranch",
    "ExamBranch": {
      "BaseUrlTemplate": "",
      "TimeoutSeconds": 15
    }
  },
  "ArtifactStorage": {
    "Provider": "r2",
    "PhysicalRoot": "",
    "Bucket": "",
    "KeyPrefix": "artifacts",
    "MultipartThresholdBytes": 5242880,
    "EnableCompression": false,
    "MaxParallelUploads": 16
  },
  "ArtifactStorage:R2": {
    "Endpoint": "",
    "AccessKeyId": "",
    "SecretAccessKey": "",
    "Region": "auto",
    "ForcePathStyle": true
  },
  "InsightFace": {
    "ModelDirectory": "models/insightface",
    "DetectionModelFile": "det_10g.onnx",
    "RecognitionModelFile": "w600k_r50.onnx",
    "DetectionThreshold": 0.5,
    "NmsThreshold": 0.4,
    "DetectionInputSize": 640,
    "RecognitionInputSize": 112,
    "ExpectedEmbeddingDimension": 512,
    "PipelineVersion": "InsightFace-1.0"
  },
  "Recognition": {
    "MatchDistanceThreshold": 0.45,
    "LowConfidenceDistanceThreshold": 0.55
  },
  "RecognitionDiagnostics": {
    "Enabled": true,
    "WorkingSetWarningThresholdMB": 450,
    "ForceGcValidation": false
  },
  "EnrollmentPipeline": {
    "PipelineName": "StudentEnrollment",
    "ActiveVersion": 1,
    "Versions": {
      "1": {
        "SchemaVersion": 1,
        "Description": "Baseline V1 — five fixed core stages, no optional AI stages enabled."
      }
    }
  },
  "Branding": {
    "Provider": "local",
    "PhysicalRoot": "",
    "PublicBaseUrl": "",
    "S3": {
      "Bucket": "",
      "Region": "us-east-1",
      "Endpoint": "",
      "AccessKeyId": "",
      "SecretAccessKey": "",
      "ForcePathStyle": true
