# Vite proxies /api, /media, and /hubs here (vite.config.ts).
# Must match the running API. Launch profile "https" binds:
#   https://localhost:7063  and  http://localhost:5210
# Prefer HTTP for the proxy hop (no local cert trust issues).
# API must NOT redirect HTTP→HTTPS in Development (that 307 strips Bearer → 401).
VITE_API_PROXY_TARGET=http://localhost:5210
